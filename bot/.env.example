BOT_TOKEN=1234567890:replace-with-your-bot-token
ALLOWED_CHAT_IDS=-1001234567890
DEFAULT_COOLDOWN_SECONDS=60
REPLY_TO_MESSAGE=true
DROP_PENDING_UPDATES=true
ENABLE_LOW_CONFIDENCE=true
ENABLE_KNOWLEDGE_FALLBACK=true
HEALTH_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3939
LOG_MESSAGE_TEXT=true
MAX_LOG_TEXT_LENGTH=120
OPS_DATA_SOURCE=local
OPS_SCOPE_SYSTEM=xboard
OPS_SCOPE_MODULE=bot
OPS_SCOPE_SERVICE=telegram_support
OPS_SCOPE_ENV=production
OPS_DB_HOST=127.0.0.1
OPS_DB_PORT=3306
OPS_DB_NAME=ops
OPS_DB_USER=root
OPS_DB_PASS=
OPS_DB_POOL_MAX=10
OPS_REFRESH_SECONDS=60
OPS_CACHE_FILE=./cache/ops-config-cache.json
OPS_WRITE_LOGS_TO_RDS=false
RULES_FILE=./rules.json
KNOWLEDGE_FILE=./knowledge.json
